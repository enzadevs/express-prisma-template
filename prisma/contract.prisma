// use prisma-8
model AdminUser {
  id           String        @id @default(uuid())
  emailAddress String?       @unique
  phoneNumber  String?       @unique
  username     String?
  password     String
  userRole     AdminUserRole @default(MANAGER)

  createdAt    temporal.createdAt()
  updatedAt    temporal.updatedAt()

  @@index([emailAddress])
  @@index([phoneNumber])
}

enum AdminUserRole {
  ADMIN
  MANAGER
}